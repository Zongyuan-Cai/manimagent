# Optional initial text-model configuration; the local UI can configure these instead.
MANIMAGENT_TEXT_BASE_URL=https://api.deepseek.com
MANIMAGENT_TEXT_MODEL=deepseek-flash
MANIMAGENT_TEXT_API_KEY=
# MANIMAGENT_CONFIG=config.yaml

# Optional initial MiMo speech configuration; the UI can configure it independently.
# The key stays in this ignored local .env file and is never copied from the core API.
MANIMAGENT_TTS_ENABLED=false
MIMO_API_KEY=
